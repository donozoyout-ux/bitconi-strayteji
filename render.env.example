# BITCONI TESTNET / RENDER ENV
NODE_ENV=production
USE_TESTNET=true
ALLOW_LIVE_TRADING=false
TRADING_MODE=on
DRY_RUN=false
EMERGENCY_STOP=false

# Binance Futures Demo/Testnet
BINANCE_TESTNET_API_KEY=YOUR_BINANCE_TESTNET_API_KEY
BINANCE_TESTNET_SECRET_KEY=YOUR_BINANCE_TESTNET_SECRET_KEY

# Google Sheets persistence
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SHEET_REQUIRED=true

# Runtime
TRADING_SYMBOL=BTC/USDT
ANALYSIS_TIMEFRAME=15m
CHECK_INTERVAL_MIN=5
BUDGET_USDT=500
SL_PERCENT=2.5
COMMISSION_RATE=0.001
COOLDOWN_MIN=60

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API protection
ADMIN_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_TOKEN
WEBHOOK_SECRET=CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_SECRET
