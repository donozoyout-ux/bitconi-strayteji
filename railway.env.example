# BITCONI TESTNET / RAILWAY
NODE_ENV=production
USE_TESTNET=true
ALLOW_LIVE_TRADING=false

# REQUIRED: Binance Futures Demo/Testnet
BINANCE_TESTNET_API_KEY=YOUR_BINANCE_TESTNET_API_KEY
BINANCE_TESTNET_SECRET_KEY=YOUR_BINANCE_TESTNET_SECRET_KEY

# REQUIRED: Telegram trade notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Runtime defaults
TRADING_SYMBOL=BTC/USDT
ANALYSIS_TIMEFRAME=15m
CHECK_INTERVAL_MIN=5
BUDGET_USDT=500
SL_PERCENT=2.5
COMMISSION_RATE=0.001
COOLDOWN_MIN=60

# Optional. Keep disabled unless explicitly needed.
GOOGLE_SHEETS_ENABLED=false

# Optional admin protection
# ADMIN_API_TOKEN=
# WEBHOOK_SECRET=
