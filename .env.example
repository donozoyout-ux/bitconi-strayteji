# ---------------------------------------------------------------
# BTC Strategy Bot - Environment variables
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=production
DEPLOY_CONFIG=canonical

# Binance Futures TESTNET / Demo
USE_TESTNET=true
ALLOW_LIVE_TRADING=false
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# Safety / execution
TRADING_MODE=on
DRY_RUN=false
EMERGENCY_STOP=false
COMMISSION_RATE=0.001
ANALYSIS_TIMEFRAME=15m
CHECK_INTERVAL_MIN=5
BUDGET_USDT=1000
TP_PERCENT=5
SL_PERCENT=2.5
COOLDOWN_MIN=60
TRADING_SYMBOL=BTC/USDT
STOCH_OVERSOLD=20
USE_RSI2_FILTER=false

# Admin protection
ADMIN_API_TOKEN=replace_with_long_random_secret
WEBHOOK_SECRET=replace_with_different_long_random_secret

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------------------------------------------------------------
# GOOGLE SHEETS PERSISTENT STORAGE - PostgreSQL replacement
# ---------------------------------------------------------------
# 1) Create a Google Sheet.
# 2) Extensions -> Apps Script.
# 3) Paste docs/google-sheets-backend.gs and deploy as Web app.
# 4) Set Apps Script property BOT_SHEETS_SECRET to the same value below.
# 5) Put the /exec Web App URL below.
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/REPLACE_ME/exec
GOOGLE_SHEETS_SECRET=replace_with_long_random_sheet_secret

# In production the bot should block trading if Sheet storage is unavailable.
SHEET_REQUIRED=true

# Legacy Google Form bridge (optional fallback only; not required for new setup)
#GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/XXXXXXXXX/formResponse
#GOOGLE_FORM_FIELDS={"tarih":"entry.111111","islem":"entry.222222","sembol":"entry.333333","fiyat":"entry.444444","miktar":"entry.555555","karZarar":"entry.666666","sonuc":"entry.777777"}
