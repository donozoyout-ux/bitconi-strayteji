# ---------------------------------------------------------------
# Dip Hunter Crypto Bot - Ortam Degiskenleri (.env dosyasi olusturup bu degerleri girin)
# Bu dosyayi kopyalayip adini ".env" yapin ve asil degerleri doldurun.
# ---------------------------------------------------------------

# Sunucu portu (Render'da genelde 3000)
PORT=3000

# Binance Testnet API anahtarlari
# Testnet anahtarlari buradan olusturulur: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# Islem komisyonu (%0.1 = 0.001). Butce hesabina dahil edilir.
# BINANCE_SPOT=0.001, BNB ile odersek 0.00075
COMMISSION_RATE=0.001

# Telegram bildirimleri
# Token: Telegram'da @BotFather -> /newbot ile bot olustur.
# Chat ID: @userinfobot'a "start" yazinca ID'n gorunur (ornek: 123456789).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------------- OTONOM ANALIZ MOTORU ----------------
# on/off: motor calissin mi
TRADING_MODE=on
# true = sanal mod (gercek emir ACMAZ, simule eder) | false = gercek testnet emri
DRY_RUN=true
# Analiz zaman dilimi: 15m, 5m, 1h, 4h, 1d...
ANALYSIS_TIMEFRAME=15m
# Kac dakikada bir analiz yapilsin
CHECK_INTERVAL_MIN=5
# Her islemde harcanacak USDT
BUDGET_USDT=30
# Take Profit (%) ve Stop Loss (%)
TP_PERCENT=5
SL_PERCENT=2.5
# Satis sonrasi tekrar alim icin bekleme (dk) - 60 = 1 saat (dakikalik grafik icin)
COOLDOWN_MIN=60
# Islem sembolu
TRADING_SYMBOL=BTC/USDT
# Stoch RSI asiri satis seviyesi
STOCH_OVERSOLD=20
# Opsiyonel RSI(2) < 10 filtresi
USE_RSI2_FILTER=false

# ---------------- GOOGLE SHEETS KAYIT (Google Forms ile) ----------------
# Google Forms acin (ornek: Tarih, Islem, Sembol, Fiyat, Miktar, Kar/Zarar, Sonuc alanlari),
# 3 nokta -> "Yanitlari gore" -> Google Sheets'e baglayin.
# GOOGLE_FORM_URL: Formun kaynak kodundaki formResponse adresi
# GOOGLE_FORM_FIELDS: JSON olarak alan -> entry.ID eslesmesi
# Ornek (kendi entry ID'lerinizi kullanin):
#GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/XXXXXXXXX/formResponse
#GOOGLE_FORM_FIELDS={"tarih":"entry.111111","islem":"entry.222222","sembol":"entry.333333","fiyat":"entry.444444","miktar":"entry.555555","karZarar":"entry.666666","sonuc":"entry.777777"}
