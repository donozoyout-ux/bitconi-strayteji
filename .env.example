# BITCONI TESTNET / RAILWAY - MINIMUM REQUIRED ENV
NODE_ENV=production
USE_TESTNET=true
ALLOW_LIVE_TRADING=false

# Binance Futures Demo/Testnet - REQUIRED FOR ORDERS
BINANCE_TESTNET_API_KEY=YOUR_BINANCE_TESTNET_API_KEY
BINANCE_TESTNET_SECRET_KEY=YOUR_BINANCE_TESTNET_SECRET_KEY

# Telegram - REQUIRED FOR TRADE NOTIFICATIONS
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Runtime (optional; defaults already exist)
TRADING_SYMBOL=BTC/USDT
ANALYSIS_TIMEFRAME=15m
CHECK_INTERVAL_MIN=5
BUDGET_USDT=500
SL_PERCENT=2.5
COMMISSION_RATE=0.001
COOLDOWN_MIN=60

# Google Sheets is OFF by default and NEVER blocks TESTNET trading.
# Do not set this unless you explicitly want Sheets again.
# GOOGLE_SHEETS_ENABLED=true
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SYNC_MINUTES=5

# Admin-only web endpoints (optional unless you use manual/admin actions)
# ADMIN_API_TOKEN=
# WEBHOOK_SECRET=
