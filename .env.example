# ---------------------------------------------------------------
# Dip Hunter Crypto Bot - Ortam Degiskenleri (.env dosyasi olusturup bu degerleri girin)
# Bu dosyayi kopyalayip adini ".env" yapin ve asil degerleri doldurun.
# ---------------------------------------------------------------

# Sunucu portu (Render'da genelde 3000)
PORT=3000

# Binance Testnet API anahtarlari
# Testnet anahtarlari buradan olusturulur: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here
