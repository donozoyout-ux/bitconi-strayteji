//@version=5
strategy("Dip Hunter BTC (BB + Stoch RSI) - 4H/1D", overlay=true,
     initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=1000,
     commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

// ============================================================
//  DIP AVCISI STRATEJISI - SADECE ALIM (LONG) - 4H & 1D
// ------------------------------------------------------------
//  GOSTERGELER:
//   1) Bollinger + RSI (Double Strategy): RSI(2) + BB(20,2) -> SADECE alt bant
//   2) RSI Bands: RSI(10) -> SADECE destek (Support) referansi
//   3) Stoch RSI: Ust bant 80 / Alt bant 20 (%K mavi, %D turuncu)
//
//  GUVCLU AL (BUY) SARTLARI (aynı mumda veya birlikte):
//   A) Fiyat (low/close) Bollinger ALT banda temas eder veya altinda kapanir
//   B) Stoch RSI %K, %D'yi 20 seviyesinin ALTINDA yukari yonlu keser (Golden Cross)
//
//  CIKIS: %5 Take Profit + %2.5 Stop Loss (asagida ayarlanabilir)
//  BACKTEST: Bu bir strategy() scripti oldugundan "Strateji Test Cihazi"
//            paneli otomatik olarak aktif olur.
//
//  NOT: Webhook JSON'unda passphrase bulunur (sunucudaki WEBHOOK_PASSPHRASE
//       ile birebir ayni olmali). Sunucu olmadan dogrudan kullanilacaksa
//       passphrase satiri silinebilir.
// ============================================================

// ===================== GIRDI AYARLARI =====================
bbLength      = input.int(20,   "Bollinger Uzunluk", minval=1)
bbMult        = input.float(2.0, "Bollinger Std. Sapma", step=0.1, minval=0.1)
rsiDoubleLen  = input.int(2,    "RSI (Double) Uzunluk", minval=1)
rsiBandsLen   = input.int(10,   "RSI Bands Uzunluk", minval=1)
stochLength   = input.int(14,   "Stoch RSI Uzunluk", minval=1)
smoothK       = input.int(3,    "Stoch RSI %K Yumusatma", minval=1)
smoothD       = input.int(3,    "Stoch RSI %D Yumusatma", minval=1)
oversoldLevel = input.int(20,   "Stoch RSI Asiri Satis Seviyesi", minval=1, maxval=100)
useRsi2Filter = input.bool(false, "RSI(2) ek filtre kullan (Opsiyonel)", tooltip="Acilirsa: alt bandin altinda RSI(2) < 10 sarti da aranir.")

// ----- Risk Yonetimi (TP / SL) -----
longTPPercent = input.float(5.0,  "Take Profit (%)",  minval=0.1, step=0.1, group="Risk Yonetimi")
longSLPercent = input.float(2.5,  "Stop Loss (%)",    minval=0.1, step=0.1, group="Risk Yonetimi")

// ----- Webhook bilgileri (Render sunucunuzla eslesmeli) -----
passphrase  = input.string("change_me_to_a_strong_secret", "Webhook Passphrase (WEBHOOK_PASSPHRASE ile ayni)", group="Webhook")
alertSymbol = input.string("BTCUSDT", "Islem Sembolu (Binance Testnet)", group="Webhook")
orderQty    = input.string("0.001", "Emir Miktari (Quantity)", group="Webhook")

// ===================== GOSTERGELER =====================
// 1) Bollinger Bands - SADECE alt bant (kirmizi destek)
basis      = ta.sma(close, bbLength)
deviation  = ta.stdev(close, bbLength) * bbMult
bbLower    = basis - deviation

// RSI(2) - Double Strategy ek filtresi
rsiDouble  = ta.rsi(close, rsiDoubleLen)

// 2) RSI Bands referansi - RSI(10)
rsiBands   = ta.rsi(close, rsiBandsLen)

// 3) Stoch RSI (K ve D)
rsiForStoch = ta.rsi(close, stochLength)
hh          = ta.highest(rsiForStoch, stochLength)
ll          = ta.lowest(rsiForStoch, stochLength)
rawStoch    = (hh - ll) != 0 ? (rsiForStoch - ll) / (hh - ll) * 100 : 50
k           = ta.sma(rawStoch, smoothK)
d           = ta.sma(k, smoothD)

// ===================== ALIM (BUY) SARTLARI =====================
// Kosul A: Fiyat alt banda temas etti veya altinda kapandi
priceTouch = low <= bbLower or close < bbLower

// Kosul B: Stoch RSI %K, %D'yi 20 altindayken yukari kesti (Golden Cross)
stochGoldenCross = ta.crossover(k, d) and k < oversoldLevel

// Opsiyonel RSI(2) dogrulamasi
rsi2Confirm = not useRsi2Filter or (close < bbLower and rsiDouble < 10)

buySignal = priceTouch and stochGoldenCross and rsi2Confirm

// ===================== STRATEJI: GIRIS + TP/SL =====================
if buySignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("TP/SL", from_entry="Long",
         limit=strategy.position_avg_price * (1 + longTPPercent / 100),
         stop=strategy.position_avg_price  * (1 - longSLPercent / 100))

// ===================== GORSELLESTIRME =====================
plot(basis,   "BB Orta Cizgi",   color=color.new(color.blue, 60))
plot(bbLower, "BB Alt Bant",     color=color.new(color.red, 20), linewidth=2)

plot(k, "Stoch RSI %K", display=display.data_window, color=color.blue)
plot(d, "Stoch RSI %D", display=display.data_window, color=color.orange)
hline(oversoldLevel, "Asiri Satis (20)", color=color.new(color.gray, 50))

plotshape(buySignal, title="BUY Sinyali", location=location.belowbar,
     style=shape.labelup, text="BUY", color=color.green, textcolor=color.white, size=size.small)

// ===================== WEBHOOK ALARMI =====================
if buySignal
    jsonBody = '{"passphrase": "' + str.tostring(passphrase) + '", "action": "BUY", "symbol": "' + str.tostring(alertSymbol) + '", "quantity": "' + str.tostring(orderQty) + '"}'
    alert(jsonBody, alert.freq_once_per_bar)

// NOT: Strateji 4H ve 1D grafiklerde calisir (grafik periyodunu kendiniz sececeksiniz).
// Emirler TradingView'den DEGIL, sunucudaki (Binance Testnet) bot tarafindan verilir.
