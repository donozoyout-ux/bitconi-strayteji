{
  "name": "bitconi-strategy-bot",
  "version": "1.1.0",
  "description": "BTC/USDT algorithmic trading bot with multi-timeframe trend strategy, risk engine, PostgreSQL state and Binance Futures TESTNET execution",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "deploy:prepare": "node scripts/fix-render-settings.js && node scripts/render-config-verify.js",
    "deploy:verify": "node scripts/render-config-verify.js",
    "railway:predeploy": "npm run deploy:prepare",
    "render:start": "npm run deploy:prepare && node server.js"
  },
  "keywords": [
    "binance",
    "bitcoin",
    "crypto",
    "trading",
    "bot",
    "algo-trading",
    "testnet"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ccxt": "^4.4.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
